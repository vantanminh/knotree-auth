# Copy to .env and fill in. Never commit real secrets.

APP_ENV=development
DATABASE_URL=postgres://knotree:knotree@127.0.0.1:5432/knotree_accounts
BIND_ADDR=127.0.0.1:8080
APP_BASE_URL=http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:5173

# development | staging | production
# Production requires https APP_BASE_URL, COOKIE_SECURE=true, no DEV_MAILBOX,
# TOTP_ENCRYPTION_KEYS, a JWT private key, and Argon2 memory >= 19456 KiB.

DEV_MAILBOX=true
EMAIL_PROVIDER=outbox
EMAIL_FROM=accounts@knotree.com
EMAIL_FROM_NAME=Knotree Accounts
# EMAIL_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_EMAIL_API_TOKEN=

# Comma-separated version:base64 32-byte keys. Active version is TOTP_ENCRYPTION_KEY_VERSION.
# TOTP_ENCRYPTION_KEYS=1:BASE64KEY
# TOTP_ENCRYPTION_KEY_VERSION=1

# JWT_PRIVATE_KEY_PEM=
# JWT_KEY_ID=knotree-1
# JWT_PREVIOUS_PUBLIC_KEY_PEM=
# JWT_PREVIOUS_KEY_ID=knotree-0

# SUPER_ADMIN_USER_ID=
# Development only. Ignored as a bootstrap source in production.
# SUPER_ADMIN_EMAIL=

# Social sign-in. Leave a pair empty to disable that provider; set both values to enable it.
# Register this redirect URI with each provider ({APP_BASE_URL}/api/v1/auth/social/<provider>/callback):
#   Google (console.cloud.google.com > APIs & Services > Credentials > OAuth client ID, type "Web application"):
#     http://localhost:5173/api/v1/auth/social/google/callback
#   GitHub (github.com/settings/developers > OAuth Apps > New OAuth App, "Authorization callback URL"):
#     http://localhost:5173/api/v1/auth/social/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Required in production. When unset in development, /metrics is open on the API.
# METRICS_TOKEN=

ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1

SESSION_TTL_HOURS=336
SESSION_IDLE_HOURS=168
ADMIN_SESSION_HOURS=12
ADMIN_IDLE_MINUTES=60
STEP_UP_MINUTES=10
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_DAYS=30
AUTH_CODE_SECONDS=60
EMAIL_OTP_SECONDS=600
VERIFICATION_HOURS=24
RESET_MINUTES=30
